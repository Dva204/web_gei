# PostgreSQL local development
DATABASE_URL="postgresql://vuon:vuon_dev_password@localhost:5432/vuon_ngon_tinh?schema=public"

# Local Docker only; match DATABASE_URL. Do not use this example password in production.
POSTGRES_PASSWORD="vuon_dev_password"
# Explicit opt-in; seed never creates accounts/admins or publishes stories.
ALLOW_DEVELOPMENT_SEED="false"
# Separate PostgreSQL test database ending in _test. Never use the app database here.
TEST_DATABASE_URL=""

# Operational backup runs pg_dump/pg_restore inside this local Docker container.
# BACKUP_ROOT may point to a mounted durable directory in production.
BACKUP_POSTGRES_CONTAINER="vuon-ngon-tinh-postgres"
BACKUP_ROOT=".data/backups"

# Public base URL for published media. With R2 production, use its HTTPS custom domain.
NEXT_PUBLIC_MEDIA_BASE_URL="http://localhost:3000"
# B4 private local vault: .data/media, served only through /api/media after access checks.
# In production, use r2. Back up this directory together with PostgreSQL only when using local.
MEDIA_STORAGE_DRIVER="local"
# Production uploads fail closed unless a durable .data/media volume is provisioned.
MEDIA_LOCAL_PERSISTENT="false"
# Cloudflare R2/S3-compatible storage. Keep secrets server-only and never commit real values.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PRIVATE_BUCKET=""
R2_PUBLIC_BUCKET=""
# CDN reconciliation deletes unreferenced cover/comic UUID objects older than this grace period.
PUBLIC_MEDIA_ORPHAN_GRACE_HOURS="24"
# Optional but required for immediate legal/security purge on a custom domain.
# Create a zone-scoped token with only Cache Purge permission.
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_CACHE_PURGE_TOKEN=""
# Canonical origin for metadata/sitemap. Use the deployed HTTPS origin in production.
SITE_URL="http://localhost:3000"

# For next dev through ngrok: exact tunnel hostname, without https:// or port.
# Restart npm run dev after setting this; separate multiple hostnames with commas.
DEV_ALLOWED_ORIGINS=""
# Exact browser origins for auth POSTs. Set the real HTTPS ngrok origin as well when testing Safari.
# No wildcards. Production fails closed when this is empty.
AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
